# Token do seu Bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave de API do Gemini (obtida gratuitamente no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo do Gemini para analise multimodal (padrao recomendado: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Opcional: IDs do Telegram autorizados a usar o bot (separados por virgula).
ALLOWED_USER_IDS=

# Opcional: Integracao com Segundo Cerebro (Notion)
# Obtenha sua chave em https://www.notion.so/my-integrations
NOTION_API_KEY=
# ID do banco de dados (tabela) no Notion onde os videos serao salvos
NOTION_DATABASE_ID=

# Opcional: Integracao com Segundo Cerebro (Obsidian via GitHub Sync)
# Repositorio privado do seu cofre no GitHub (ex: PablusVinii/meu-obsidian)
OBSIDIAN_GITHUB_REPO=PablusVinii/meu-obsidian
# Token pessoal do GitHub (classic PAT com permissao de repo) obtido em https://github.com/settings/tokens
OBSIDIAN_GITHUB_TOKEN=
# Pasta dentro do cofre onde as notas de videos serao salvas (padrao: Inbox)
OBSIDIAN_VAULT_FOLDER=Inbox
