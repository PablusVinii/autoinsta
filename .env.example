# Token do seu Bot do Telegram (obtido com o @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave de API do Gemini (obtida gratuitamente no Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo do Gemini para análise multimodal (padrão recomendado: gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# Opcional: IDs do Telegram autorizados a usar o bot (separados por vírgula).
# Deixe em branco se quiser permitir que qualquer pessoa use.
# Exemplo: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
